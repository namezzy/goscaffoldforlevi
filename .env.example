# Copy to .env for local development. .env is gitignored; this file is not,
# so it must never contain a real credential.
#
# Precedence: real environment variables > .env > built-in defaults.
# Every value below is the built-in default unless marked otherwise, so a
# minimal .env only needs the entries you actually want to change.

# ---------------------------------------------------------------- application
APP_NAME=goscaffoldforlevi
# One of: development, staging, production. Anything else is rejected on load.
APP_ENV=development
APP_VERSION=dev
# One of: debug, info, warn, error.
LOG_LEVEL=debug

# ----------------------------------------------------------------------- http
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
# Must exceed HTTP_REQUEST_TIMEOUT, or the connection is torn down before the
# timeout middleware can answer and the client sees a reset instead of a 504.
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_REQUEST_TIMEOUT=15s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=1048576
# Total budget for graceful shutdown. Kubernetes
# terminationGracePeriodSeconds must be larger than this.
HTTP_SHUTDOWN_TIMEOUT=30s
# How long /ready reports failure before the listener closes, so the load
# balancer has time to stop routing here. Must be less than the shutdown
# timeout.
HTTP_READINESS_DRAIN_DELAY=5s
# Comma-separated. "*" is rejected when APP_ENV=production.
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of this service. 0 means
# X-Forwarded-For is ignored entirely, which is the only safe default because
# the header is client-controlled. Set it to the real count, never higher.
HTTP_TRUSTED_PROXY_COUNT=0

# ------------------------------------------------------------------- database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/goscaffold?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=10m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=5s

# ---------------------------------------------------------------------- redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# false: a Redis outage degrades the service but does not remove it from the
# load balancer. Set to true only for components that cannot work without it.
REDIS_REQUIRED=false
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=3s
REDIS_POOL_SIZE=10

# ----------------------------------------------------------------------- auth
# PLACEHOLDER. Startup fails when APP_ENV=production and this value is still
# one of the known example secrets. Generate a real one with:
#   openssl rand -base64 48
AUTH_JWT_SECRET=change-me-in-production-0000000000
AUTH_ISSUER=goscaffoldforlevi
AUTH_AUDIENCE=goscaffoldforlevi-api
# Short-lived by design: a leaked access token stays useful only this long.
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

# Argon2id cost. 64 MiB / t=3 / p=4 is the OWASP recommendation. Raise memory
# first when hardware allows: it is the parameter GPU attackers cannot buy
# their way around. Note that every login allocates this much, which is why
# RATELIMIT_LOGIN_* below is not optional.
AUTH_ARGON2_TIME=3
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_THREADS=4

# ------------------------------------------------------------------ ratelimit
# Quotas are "QUOTA requests per PERIOD, with BURST allowed at once".
# BURST must be >= QUOTA.
#
# Buckets live in Redis so that the quota is shared across replicas. If Redis
# is unreachable, the ip/user scopes fall back to a loose in-process limiter
# (fail open) while the login scopes reject with 503 (fail closed) — see
# ADR-0008.
RATELIMIT_ENABLED=true

RATELIMIT_IP_QUOTA=100
RATELIMIT_IP_PERIOD=1m
RATELIMIT_IP_BURST=200

RATELIMIT_USER_QUOTA=600
RATELIMIT_USER_PERIOD=1m
RATELIMIT_USER_BURST=1000

# Login limits are deliberately severe. Both must pass: the IP limit stops one
# source enumerating many accounts, the identifier limit stops many sources
# targeting one account.
RATELIMIT_LOGIN_IP_QUOTA=10
RATELIMIT_LOGIN_IP_PERIOD=15m
RATELIMIT_LOGIN_IP_BURST=10

RATELIMIT_LOGIN_ID_QUOTA=5
RATELIMIT_LOGIN_ID_PERIOD=15m
RATELIMIT_LOGIN_ID_BURST=5

# --------------------------------------------------------------------- messaging
# Off by default, and that default is the point: with messaging disabled the
# service writes no outbox rows, needs no broker, and needs no worker process.
# A project that never becomes asynchronous pays nothing for this being here.
#
# Turning it on requires deploying cmd/worker as well. The API only records
# events; nothing is delivered without the worker.
MESSAGING_ENABLED=false

MESSAGING_NATS_URLS=nats://localhost:4222
MESSAGING_STREAM_NAME=EVENTS
MESSAGING_SUBJECT_PREFIX=events

# The durable consumer name is written into the dedupe log. Renaming it makes
# every previously processed event look new, so treat it as permanent.
MESSAGING_CONSUMER_NAME=worker

MESSAGING_CONNECT_TIMEOUT=5s
MESSAGING_PUBLISH_TIMEOUT=10s
MESSAGING_STREAM_MAX_AGE=168h

# Must exceed the whole retry budget below, or the broker redelivers a message
# while the consumer is still working on it. Startup refuses if it does not.
MESSAGING_ACK_WAIT=5m
MESSAGING_MAX_DELIVER=10

# The poll interval is the floor on end-to-end latency: an event waits at most
# this long before the relay looks for it. Lower it for snappier delivery, at
# the cost of one more query per second per replica.
MESSAGING_RELAY_POLL_INTERVAL=1s
MESSAGING_RELAY_BATCH_SIZE=100

MESSAGING_HANDLER_TIMEOUT=30s
MESSAGING_MAX_ATTEMPTS=5
MESSAGING_BASE_BACKOFF=1s
MESSAGING_MAX_BACKOFF=30s

# Delivered events are kept for a week for debugging. The dedupe log is kept far
# longer and must outlast MESSAGING_STREAM_MAX_AGE: prune it sooner and a
# redelivered message would be processed a second time.
MESSAGING_PUBLISHED_RETENTION=168h
MESSAGING_PROCESSED_RETENTION=720h
MESSAGING_PRUNE_INTERVAL=1h

# ---------------------------------------------------------------- observability
# Instrumentation is always compiled in; this only controls whether spans and
# metrics leave the process.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# grpc or http. With http the endpoint needs the scheme and the collector's
# base URL (http://localhost:4318), not the gRPC host:port form.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Only correct when the collector shares a pod or a compose network. Anything
# that crosses a host boundary should be leaving this false.
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SAMPLING_RATIO=0.1

# The scrape endpoint is a separate listener, on loopback by default: metrics
# name every route template, dependency and build version, and the API port is
# the one meant to be reachable from outside. In production the loader refuses
# to serve them on the public address at all.
METRICS_ENABLED=true
METRICS_ADDR=127.0.0.1:9464
METRICS_PATH=/metrics
