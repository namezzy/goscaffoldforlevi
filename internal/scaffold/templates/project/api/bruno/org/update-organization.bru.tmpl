meta {
  name: update organization
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/org
  body: json
  auth: inherit
}

script:pre-request {
  bru.setVar("orgName", "Bruno Org " + Date.now());
  bru.setVar("orgIdentifier", "bruno-org-" + Date.now());
}

body:json {
  {
    "name": "{{orgName}}",
    "identifier": "{{orgIdentifier}}"
  }
}

assert {
  res.status: eq 200
  res.body.name: eq {{orgName}}
  res.body.identifier: eq {{orgIdentifier}}
}

docs {
  Requires org:update. name and identifier are both optional in the
  request, but at least one must be present; this request exercises both
  at once. identifier is a short label for the organization — see
  Organization's schema description.
}
