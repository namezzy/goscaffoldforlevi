meta {
  name: password reset request unknown identifier
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/auth/password-reset/request
  body: json
  auth: none
}

body:json {
  {
    "identifier": "nobody-at-all@example.com"
  }
}

assert {
  res.status: eq 202
}

docs {
  Same request, same 202, as auth/password-reset-request.bru — for an
  address that matches no account at all. The two are indistinguishable on
  purpose: see RequestPasswordReset's own doc comment on the
  account-enumeration guarantee this is asserting.
}
