meta {
  name: password reset confirm invalid token
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/auth/password-reset/confirm
  body: json
  auth: none
}

body:json {
  {
    "token": "this-token-was-never-issued",
    "password": "a perfectly fine new password"
  }
}

assert {
  res.status: eq 400
  res.body.error.code: eq PASSWORD_RESET_TOKEN_INVALID
}

docs {
  Unknown, expired and already-used tokens all answer the same way — this
  request only exercises "unknown", since nothing in this collection has a
  mailbox to redeem a real token from (see auth/password-reset-request.bru).
}
