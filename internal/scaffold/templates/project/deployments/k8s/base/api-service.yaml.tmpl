apiVersion: v1
kind: Service
metadata:
  name: goscaffold-api
  labels:
    app.kubernetes.io/name: goscaffoldforlevi
    app.kubernetes.io/component: api
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: goscaffoldforlevi
    app.kubernetes.io/component: api
  ports:
    - name: http
      port: 80
      targetPort: http
      protocol: TCP
  # The metrics port is intentionally not listed.
  #
  # Publishing 9464 through the Service would make it reachable by anything
  # that can resolve the Service name, and metric labels enumerate every route
  # template, dependency and build version. A scraper should address the pod
  # directly (a ServiceMonitor does this by default), which keeps the exposure
  # to whatever the NetworkPolicy allows.
