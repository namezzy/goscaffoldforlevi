// Package notification holds the in-app notification domain: creating one
// (called by whichever feature's action causes it — ticket, user) and
// reading them back (always scoped to the caller's own account).
//
// It knows nothing about HTTP or SQL — those live in notificationhttp and
// notificationpg. Unlike audit, there is no admin-facing write endpoint and
// also no admin-facing READ endpoint: a notification exists for exactly one
// recipient, and every read method here is implicitly scoped to whichever
// principal is in ctx. There is nothing to authorize beyond "are you signed
// in" — nobody ever has a reason to ask for a permission that would let them
// read someone else's notifications.
package notification

import (
	"context"
	"errors"
	"time"

	"github.com/google/uuid"

	"github.com/namezzy/goscaffoldforlevi/internal/apperr"
	"github.com/namezzy/goscaffoldforlevi/internal/auth"
)

// NewNotification is one notification to create.
//
// DedupKey, together with the recipient, is what makes creating the same
// notification twice a no-op instead of a duplicate: a ticket action that
// runs twice (a retried request, a race) computes the same key both times
// — see internal/ticket's dedup key construction — and the second Create
// silently does nothing rather than erroring, because "someone already
// knows about this" is success, not failure, from the caller's point of
// view.
type NewNotification struct {
	UserID     string
	Type       string
	Title      string
	Body       string
	TargetType string
	TargetID   string
	DedupKey   string
}

// Notification is a persisted notification, as returned to its recipient.
type Notification struct {
	ID         string
	UserID     string
	Type       string
	Title      string
	Body       string
	TargetType string
	TargetID   string
	ReadAt     *time.Time
	CreatedAt  time.Time
}

// Store is the persistence port.
type Store interface {
	// Create is expected to sometimes do nothing — see NewNotification's
	// doc comment on DedupKey — which is not reported as an error. id is
	// generated by Service.Notify, not here, matching every other entity
	// in this codebase (ADR-0006): an entity has its identity before it
	// reaches the database.
	Create(ctx context.Context, id string, n NewNotification) error
	ListFiltered(ctx context.Context, userID string, unreadOnly bool, limit, offset int32) ([]Notification, error)
	CountFiltered(ctx context.Context, userID string, unreadOnly bool) (int64, error)
	CountUnread(ctx context.Context, userID string) (int64, error)
	// MarkRead is scoped by userID as well as id, so one member can never
	// mark another's notification read via a guessed id.
	MarkRead(ctx context.Context, id, userID string) error
	MarkAllRead(ctx context.Context, userID string) error
}

// Service holds the notification use cases.
type Service struct {
	store Store
}

// NewService wires the service.
func NewService(store Store) *Service { return &Service{store: store} }

// Notify creates a notification. It has no permission check, matching
// audit.Service.Record's reasoning exactly: creating a notification is
// never something a principal directly asks to do, it is always a side
// effect of another action already authorized by its own service (ticket
// assignment, a role change) — see ticket.Service's NotificationRecorder.
func (s *Service) Notify(ctx context.Context, n NewNotification) error {
	if n.UserID == "" || n.Type == "" || n.DedupKey == "" {
		return apperr.Internal(errors.New("notification: UserID, Type and DedupKey are required"))
	}
	return s.store.Create(ctx, NewID(), n)
}

// Page is one slice of a listing together with the total a client needs to
// render pagination controls.
type Page struct {
	Items      []Notification
	Page       int
	PageSize   int
	Total      int64
	TotalPages int
}

// Pagination bounds, matching every other listing in this codebase
// (ADR-0004).
const (
	DefaultPageSize = 20
	MaxPageSize     = 100
)

// List returns the caller's own notifications, optionally narrowed to
// unread ones.
func (s *Service) List(ctx context.Context, unreadOnly bool, page, pageSize int) (Page, error) {
	userID, err := callerID(ctx)
	if err != nil {
		return Page{}, err
	}
	if page < 1 {
		page = 1
	}
	switch {
	case pageSize < 1:
		pageSize = DefaultPageSize
	case pageSize > MaxPageSize:
		pageSize = MaxPageSize
	}

	total, err := s.store.CountFiltered(ctx, userID, unreadOnly)
	if err != nil {
		return Page{}, err
	}
	totalPages := int((total + int64(pageSize) - 1) / int64(pageSize))
	offset := int32((page - 1) * pageSize) //nolint:gosec // bounded by the clamp above
	items, err := s.store.ListFiltered(ctx, userID, unreadOnly, int32(pageSize), offset)
	if err != nil {
		return Page{}, err
	}
	return Page{Items: items, Page: page, PageSize: pageSize, Total: total, TotalPages: totalPages}, nil
}

// UnreadCount is the number the sidebar badge shows.
func (s *Service) UnreadCount(ctx context.Context) (int64, error) {
	userID, err := callerID(ctx)
	if err != nil {
		return 0, err
	}
	return s.store.CountUnread(ctx, userID)
}

// MarkRead marks one of the caller's own notifications read. Marking an
// already-read one, or one that does not belong to the caller, is not an
// error — see Repository's doc comment in notificationpg.
func (s *Service) MarkRead(ctx context.Context, id string) error {
	userID, err := callerID(ctx)
	if err != nil {
		return err
	}
	return s.store.MarkRead(ctx, id, userID)
}

// MarkAllRead marks every one of the caller's unread notifications read.
func (s *Service) MarkAllRead(ctx context.Context) error {
	userID, err := callerID(ctx)
	if err != nil {
		return err
	}
	return s.store.MarkAllRead(ctx, userID)
}

func callerID(ctx context.Context) (string, error) {
	principal, ok := auth.PrincipalFrom(ctx)
	if !ok {
		return "", auth.ErrMissingCredentials()
	}
	return principal.UserID, nil
}

// NewID mints a UUIDv7 for a new notification, matching user.NewID (ADR-0006).
func NewID() string { return uuid.Must(uuid.NewV7()).String() }
