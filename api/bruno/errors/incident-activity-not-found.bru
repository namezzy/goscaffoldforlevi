meta {
  name: incident activity not found
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/api/v1/incidents/01a05c5c-0000-7000-8000-000000000000/activity
  body: none
  auth: inherit
}

assert {
  res.status: eq 404
  res.body.error.code: eq INCIDENT_NOT_FOUND
}

docs {
  GetActivity looks up the incident before reading its timeline, so a
  non-existent id answers the same 404 as GET /incidents/{id}.
}
