meta {
  name: login as member
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  // Access tokens are verified by signature alone, with no lookup, so one
  // minted earlier stays usable for its full fifteen minutes even after
  // cleanup-member deletes the account it names. In the GUI runtime
  // variables survive across clicks, so without this a refused login would
  // leave the previous token in place and users-forbidden would answer 403
  // and pass — asserting a permission check against a deleted user. The CLI
  // starts each run with empty variables and does not have that problem.
  bru.setVar("memberAccessToken", "");
}

body:json {
  {
    "email": "{{memberEmail}}",
    "password": "{{memberPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("memberAccessToken", res.body.access_token);
  }
}

assert {
  res.status: eq 200
}

docs {
  Writes memberAccessToken, deliberately not accessToken: overwriting the
  administrator's token here would make every later request fail with 403
  for reasons that have nothing to do with what they are testing.
}
