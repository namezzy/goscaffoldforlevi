meta {
  name: revoke other sessions
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/revoke-others
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.sessions_revoked: gte 1
}

docs {
  "Log out everywhere else." Requires no request body — the session to
  spare is whichever one this request is itself authenticated through
  (the primary login's). login-tertiary.bru's session is what this
  revokes; asserted as >= 1 rather than an exact count, since exactly how
  many other sessions exist depends on how many times this collection, or
  a person, has logged in as this account recently.
}
