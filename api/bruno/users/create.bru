meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: inherit
}

script:pre-request {
  // A fixed address makes the second run fail with 409 and look like a bug
  // in create rather than leftover state from the first run.
  bru.setVar("userEmail", "bruno-user-" + Date.now() + "@example.com");
  bru.setVar("userPassword", "correct horse battery staple");
}

body:json {
  {
    "email": "{{userEmail}}",
    "name": "Bruno User",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  // Runs for every response, not only 2xx. Storing undefined here would
  // send the rest of the folder at a nonsense URL and hide the real cause.
  if (res.getStatus() === 201) {
    bru.setVar("userId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.status: eq active
  res.body.role: eq user
}

docs {
  Stores userId for the rest of this folder.

  role is omitted on purpose. It is an accepted field, but sending "user"
  and then asserting the response says "user" would only prove the server
  echoes what it was given. Leaving it out makes that assertion test the
  thing worth testing: that the default is the least privileged value, so a
  forgotten field cannot quietly produce an administrator.

  status is not accepted from the client at all; it is set to active by the
  service.
}
